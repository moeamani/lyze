# ── Core ───────────────────────────────────────────────────────────────
# Public base URL of the app (used in emails, share links, QR codes).
APP_URL=http://localhost:3000

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# ── Database ───────────────────────────────────────────────────────────
# Leave empty to use the embedded PGlite database stored in ./.data/pglite.
# Set to a Postgres URL for production.
DATABASE_URL=
# Optional: where PGlite stores data (default ./.data/pglite, "memory://" for in-memory).
PGLITE_DIR=

# ── Sign-in ────────────────────────────────────────────────────────────
# SMTP connection string for magic-link emails, e.g. smtp://user:pass@smtp.example.com:587
# When empty, links are printed to the server console and shown at /dev/mailbox.
EMAIL_SERVER=
EMAIL_FROM="Lyze <hello@lyze.local>"

# Google sign-in appears only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Expose /dev/mailbox outside development (e2e runs against `next start`). Never in real prod.
LYZE_DEV_MAILBOX=
