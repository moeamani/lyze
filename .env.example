# ── Core ───────────────────────────────────────────────────────────────
# Public base URL of the app (used in emails, share links, QR codes).
APP_URL=http://localhost:3000

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# ── Database ───────────────────────────────────────────────────────────
# Leave empty to use the embedded PGlite database stored in ./.data/pglite.
# Set to a Postgres URL for production.
DATABASE_URL=
# Vercel / Neon integrations may set POSTGRES_URL instead; either works.
# Optional: where PGlite stores data (default ./.data/pglite, "memory://" for in-memory).
PGLITE_DIR=

# ── Sign-in ────────────────────────────────────────────────────────────
# SMTP connection string for magic-link emails, e.g. smtp://user:pass@smtp.example.com:587
# When empty, links are printed to the server console and shown at /dev/mailbox.
EMAIL_SERVER=
EMAIL_FROM="Lyze <hello@lyze.local>"

# Google sign-in appears only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Expose /dev/mailbox outside development (e2e runs against `next start`). Never in real prod.
LYZE_DEV_MAILBOX=

# ── File storage (uploads, recordings) ────────────────────────────────
# Vercel Blob (set automatically when a Blob store is connected): browsers upload files straight
# to private Blob storage. Takes priority over S3.
BLOB_READ_WRITE_TOKEN=
# Leave S3_BUCKET empty to store files on local disk in UPLOADS_DIR (default ./.data/uploads).
UPLOADS_DIR=
# Any S3-compatible service (AWS S3, Cloudflare R2, MinIO, Backblaze B2…).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Spam protection ───────────────────────────────────────────────────
# Optional Cloudflare Turnstile captcha for public forms (both keys required).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Interviews ────────────────────────────────────────────────────────
# Largest session recording accepted, in MB (default 500).
MEDIA_MAX_MB=
# Speech-to-text. Empty → the mock provider (a sample transcript built from the interview guide).
# "openai" → any OpenAI-compatible /audio/transcriptions endpoint (OpenAI, Groq, self-hosted Whisper…).
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# ── AI ────────────────────────────────────────────────────────────────
# Lyze AI: the model every workspace uses by default, with no key of its own. A Google
# Gemini key from https://aistudio.google.com/apikey works out of the box. Keep it secret:
# set it in your host's environment or .env.local, never in a committed file.
LYZE_AI_KEY=
# Optional: another provider for Lyze AI (anthropic, groq, openrouter, mistral, openai,
# ollama, custom), its model (default gemini-3.8-flash for Gemini) and endpoint.
LYZE_AI_PROVIDER=
LYZE_AI_MODEL=
LYZE_AI_BASE_URL=
# Older setups: an Anthropic key used as Lyze AI when LYZE_AI_KEY is empty.
ANTHROPIC_API_KEY=
# Model for that Anthropic key (default claude-opus-5-5).
AI_MODEL=
# "claude": scripts/jobs without an explicit choice use the Anthropic key.
AI_PROVIDER=
# Workspaces can still add their own provider and key in Settings → AI (stored encrypted).
# Placeholder generation and test data appear only for people who turn on Dev Mode in
# their account settings.

# ── Sign-in ──────────────────────────────────────────────────────────
# People sign up with a username and password. Email magic links need a mail provider
# (see above); set 1 to offer them. Off by default ("Coming soon" on the sign-in page).
AUTH_EMAIL_ENABLED=
